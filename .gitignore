# Datasets, shards and large artifacts - never committed (local / cluster only).
# This covers raw sources, merged_dataset/, asl_shards/, splits, norm_stats, etc.
data/

# Downloaded ImageNet backbone weights (large; fetched by scripts/download_weights.py)
pretrained_weights/

# Saved checkpoints are large, so they stay local - except the MobileNet one,
# which is tracked on purpose so the real-time demo works out of the box
# (see README "Real-time inference").
checkpoints/*
!checkpoints/transfer_mobilenet_v3_small/
checkpoints/transfer_mobilenet_v3_small/*
!checkpoints/transfer_mobilenet_v3_small/best.pt

